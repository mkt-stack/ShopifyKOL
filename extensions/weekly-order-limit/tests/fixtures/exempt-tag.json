        "step": "CHECKOUT_COMPLETION"
      },
      "localization": {
        "language": {
          "isoCode": "EN"
        }
      },
      "shop": {
        "localTime": {
          "date": "2026-11-11"
        }
      },
      "validation": {
        "config": {
          "jsonValue": {
            "enabled": true,
            "limit": 3,
            "tags": [
              "STAFF",
              "VIP",
              "KOL"
            ],
            "exemptTags": [
              "STAFF"
