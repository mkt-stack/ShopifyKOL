generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model TikTokUrl {
  id               String   @id @default(cuid())
  shop             String
  orderId          String
  orderName        String?
  customerName     String?
  customerEmail    String?
  url              String
  videoId          String?
  creatorHandle    String?
  postDate         DateTime?
  createdAt        DateTime @default(now())

  metafieldUpdated Boolean  @default(false)
  metafieldError   String?

  noteUpdated      Boolean  @default(false)
  noteError        String?

  flowTriggered    Boolean  @default(false)
  flowTriggerError String?

  @@index([shop, orderId])
  @@index([createdAt])
  @@index([videoId])
}

model OrderTagState {
  id        String   @id @default(cuid())
  shop      String
  orderId   String
  tags      String
  updatedAt DateTime @updatedAt

  @@unique([shop, orderId])
}

model OrderQuotaAdjustment {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  orderName     String
  extraQuota    Int
  newTotalQuota Int
  adjustedBy    String
  createdAt     DateTime @default(now())

  @@index([shop, orderId])
  @@index([createdAt])
}

model ShopSettings {
  id                String   @id @default(cuid())
  shop              String   @unique
  dailyLimitEnabled Boolean  @default(false)
  dailyLimit        Int      @default(20)
  tiktokEnabled     Boolean  @default(true)
  shopeeEnabled     Boolean  @default(true)
  requireRegisteredTiktokHandle Boolean @default(false)
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Weekly order limit (checkout validation + checkout widget). The app keeps
// this row as the source of truth and copies it to the validation's
// `$app:config` metafield on every save, because the Function can't reach
// the app at checkout. See app/lib/weekly-limit.server.js.
model WeeklyOrderLimitSettings {
  id            String   @id @default(cuid())
  shop          String   @unique
  enabled       Boolean  @default(false)
  defaultLimit  Int      @default(3)
  exemptTags    Json     @default("[]")
  // [{ "tag": "VIP", "limit": 10 }] — the highest limit among a customer's tags wins.
  overrides     Json     @default("[]")
  // { "th": { ok, fullTitle, full, login }, "en": { ... } } — blank keys fall back to defaults.
  messages      Json     @default("{}")
  validationId  String?
  lastSyncedAt  DateTime?
  lastSyncError String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
